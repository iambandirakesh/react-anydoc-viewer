{
  "name": "react-anydoc-viewer",
  "version": "0.1.3",
  "description": "Free, open-source, watermark-free React component that renders PowerPoint (.pptx), Word (.docx), Excel (.xlsx), PDF, TIFF and other document files in the browser. No paid APIs, no external services.",
  "keywords": [
    "react",
    "pptx",
    "docx",
    "xlsx",
    "excel",
    "spreadsheet",
    "tiff",
    "pdf",
    "powerpoint",
    "word",
    "viewer",
    "slides",
    "ooxml",
    "presentation",
    "document",
    "typescript"
  ],
  "license": "MIT",
  "author": "react-anydoc-viewer contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iambandirakesh/react-anydoc-viewer.git"
  },
  "homepage": "https://github.com/iambandirakesh/react-anydoc-viewer#readme",
  "bugs": {
    "url": "https://github.com/iambandirakesh/react-anydoc-viewer/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "ARCHITECTURE.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config examples/demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/demo/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "test:browser": "playwright test",
    "bench": "playwright test -c bench",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && node scripts/prepublish-guard.mjs",
    "build:demo": "vite build --config examples/demo/vite.config.ts",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^5.7.284",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@rolldown/binding-darwin-arm64": "^1.2.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
